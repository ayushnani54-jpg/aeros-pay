# Copy this file to .env for local development, or configure these as
# Environment Variables in your Vercel project settings for deployment.

# PostgreSQL connection string for the app's single relational database.
# Any standard Postgres provider works (Vercel Postgres/Neon, Supabase, Railway, RDS, etc).
DATABASE_URL="postgresql://user:password@host:5432/database"

# Secret used to sign session JWTs (both user and Government sessions).
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 48
AUTH_SECRET="replace-with-a-long-random-secret-at-least-32-characters"

# ---------------------------------------------------------------------------
# One-time Government account seed. These three values are ONLY read by
# `npm run seed:government`, which creates the single Government row the
# first time it is run (it is a no-op on every run after that — see README
# for details). They are not read anywhere else and are safe to remove from
# the environment after the initial seed has been run.
# ---------------------------------------------------------------------------

# Government login username.
GOV_USERNAME="government"

# Government login password (min 8 characters). Change this before seeding
# a real deployment — the value here is a placeholder.
GOV_PASSWORD="ChangeThisPassword123"

# Government security code: 5+ uppercase alphanumeric characters (e.g. G7K2P).
# Required on every Government login in addition to username + password.
GOV_SECURITY_CODE="G7K2P"

# ---------------------------------------------------------------------------
# Scheduled cleanup (V3 Phase I).
# ---------------------------------------------------------------------------
# Shared secret for the one scheduled job, /api/cron/cleanup. On Vercel, set
# this as a project Environment Variable: the platform then sends its value as
# `Authorization: Bearer <CRON_SECRET>` on every cron invocation, which is the
# documented mechanism and what the route checks (in constant time).
#
# IF THIS IS NOT SET, THE ROUTE REFUSES EVERY REQUEST. An unset secret never
# means "open" — the endpoint is simply unavailable until one is configured.
#
# Generate one with:  openssl rand -base64 32
#
# The schedule itself lives in vercel.json and is ONE DAILY JOB, because the
# Hobby plan allows only daily cron granularity and Vercel may fire it anywhere
# within the scheduled hour. The app does not depend on it: the Government
# pages run the same cleanup lazily at most once per IST day as a fallback.
CRON_SECRET="replace-with-a-long-random-secret"
