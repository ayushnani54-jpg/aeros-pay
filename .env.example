# ==============================================================================
# AEROS PAY V4.1 — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy to .env.local for local development or configure in Vercel Project Settings.
# NEVER commit real secrets, tokens, or connection strings to Git.

# 1. Neon PostgreSQL Operational Database (Required)
DATABASE_URL="postgresql://USER:PASSWORD@ep-example.ap-southeast-1.aws.neon.tech/neondb?sslmode=require"

# 2. Authentication & Session Signing (Required in Production — min 32 random chars)
SESSION_SECRET="replace-with-at-least-32-bytes-of-cryptographically-random-hex"

# 3. Government Bootstrap Credentials (Used by db:seed on first initialization)
GOV_INITIAL_PASSWORD="replace-with-strong-government-password"

# 4. Scheduled Cleanup & 24h GitHub Archival Cron Authorization (Vercel Cron)
CRON_SECRET="replace-with-random-cron-bearer-secret"

# 5. V4.1 5-Repository Private GitHub Historical Archive Layer
# Create 5 private repositories under your GitHub account or organization:
#   - aeros-archive-ledger
#   - aeros-archive-contracts
#   - aeros-archive-market
#   - aeros-archive-economy
#   - aeros-archive-audit
# Fine-grained Personal Access Token (PAT) with Contents: Read & Write on ONLY those 5 private repos:
GITHUB_ARCHIVE_OWNER="your-github-username-or-org"
GITHUB_ARCHIVE_TOKEN="github_pat_replace_with_fine_grained_token"
GITHUB_ARCHIVE_BRANCH="main"

# Optional per-category repository base name overrides (defaults shown):
GITHUB_REPO_LEDGER="aeros-archive-ledger"
GITHUB_REPO_CONTRACTS="aeros-archive-contracts"
GITHUB_REPO_MARKET="aeros-archive-market"
GITHUB_REPO_ECONOMY="aeros-archive-economy"
GITHUB_REPO_AUDIT="aeros-archive-audit"

# 6. Optional Web Push Notifications (VAPID)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:admin@example.com"
